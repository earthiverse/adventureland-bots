{
  "extends": "@total-typescript/tsconfig/tsc/no-dom/library",
  "compilerOptions": {
    "incremental": true,
    "lib": ["ES2024"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.all.node.tsbuildinfo",
    "noEmit": true,
    "target": "ES2024",
    "types": ["bun", "node"]
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "types/**/*.ts", "tests/**/*.ts", "*.config.js"]
}
